    {
        "id": "df2802435f602fa1",
        "type": "function",
        "z": "905bbdee05dfa1b2",
        "g": "af6021a9e7446930",
        "name": "function relay",
        "func": "var requestId = msg.topic.split('/').pop();\nvar method = msg.payload.method;\nvar status = msg.payload.params;\n\nvar msgToDAM = {};\nvar msgToTB_RPC = { topic: \"v1/devices/me/rpc/response/\" + requestId };\nvar msgToTB_Telemetry = { topic: \"v1/devices/me/telemetry\" };\n\nvar relay1_state = flow.get('relay1_state') || false;\nvar relay2_state = flow.get('relay2_state') || false;\n\nif (method === 'getState1') {\n    msgToTB_RPC.payload = relay1_state;\n    return [null, msgToTB_RPC];\n}\n\nif (method === 'getState2') {\n    msgToTB_RPC.payload = relay2_state;\n    return [null, msgToTB_RPC];\n}\n\nif (method === 'setState1') {\n    msgToDAM.topic = \"dam/control/relay1\";\n    msgToDAM.payload = status ? \"1\" : \"0\";\n\n    msgToTB_RPC.payload = status;\n    msgToTB_Telemetry.payload = { \"status\": status ? \"RUN\" : \"STOP\" };\n\n    flow.set('relay1_state', status);\n\n    return [msgToDAM, [msgToTB_RPC, msgToTB_Telemetry]];\n}\n\nif (method === 'setState2') {\n    msgToDAM.topic = \"dam/control/relay2\";\n    msgToDAM.payload = status ? \"1\" : \"0\";\n\n    msgToTB_RPC.payload = status;\n    msgToTB_Telemetry.payload = { \"status2\": status ? \"RUN\" : \"STOP\" };\n\n    flow.set('relay2_state', status);\n\n    return [msgToDAM, [msgToTB_RPC, msgToTB_Telemetry]];\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
