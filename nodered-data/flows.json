    {
        "id": "0d45d4909fda0d29",
        "type": "function",
        "z": "905bbdee05dfa1b2",
        "g": "18c42bb706291de6",
        "name": "analog function",
        "func": "// เช็กว่าข้อมูลที่ส่งมาเป็น JSON (Object) อยู่แล้วไหม\nif (typeof msg.payload === 'object') {\n    return msg;\n} else {\n    // ดึงป้ายชื่อที่มา (Topic) มาหั่นด้วยเครื่องหมาย \"/\"\n    var topicParts = msg.topic.split(\"/\");\n    // ดึงเอาคำสุดท้ายของ Topic มาใช้เป็นชื่อเซ็นเซอร์\n    var sensorName = topicParts[topicParts.length - 1];\n    // แปลงค่าข้อมูลดิบให้เป็นตัวเลข\n    var rawData = Number(msg.payload);\n    // ดึงเวลาปัจจุบันของคอมพิวเตอร์ (หน่วยเป็นมิลลิวินาที - Unix Timestamp)\n    var currentTime = Date.now();\n    // ห่อใส่โครงสร้าง JSON\n    msg.payload = {\n        \"ts\": currentTime,\n        \"values\": {}\n    };\n    msg.payload.values[sensorName] = rawData;\n    \n    return msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1080,
        "y": 460,
        "wires": [
            [
                "c3f1efe136476e6a",
                "9afb999ba4bfb895"
            ]
        ]
    },
